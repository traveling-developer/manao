---
import { Image } from "astro:assets";
import symbol from "../assets/manao_symbol_beige.webp";

const { class: className } = Astro.props;
---

<div class:list={["flex w-full justify-center py-8", className]}>
  <div class="flex w-2/3 max-w-3xl items-center gap-4">
    <div class="bg-manao-beige h-0.5 flex-1 rounded-full"></div>
    <Image
      src={symbol}
      alt=""
      width={64}
      densities={[1, 2]}
      class="h-8 w-8 shrink-0"
      loading="lazy"
    />
    <div class="bg-manao-beige h-0.5 flex-1 rounded-full"></div>
  </div>
</div>
