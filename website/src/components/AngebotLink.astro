---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "border-manao/30 from-manao/10 text-manao-dark hover:bg-manao block rounded-lg border bg-gradient-to-b to-white px-4 py-3 transition-colors duration-300 hover:bg-none hover:text-white",
    className,
  ]}
>
  <slot />
</a>
